---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/sections/Header.astro';
import Footer from '../components/sections/Footer.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="es" data-theme="dark" class="dark">
  <head>
    <BaseHead
      title={`Evidencias | ${SITE_TITLE}`}
      description="Evidencias académicas de SQL, PL/SQL Scripts, NoSQL y Proyecto."
    />
  </head>

  <body>
    <Header />

    <main class="evidencias-page">

      <section class="evidencias-header">
        <span class="section-label">PORTAFOLIO ACADÉMICO</span>

        <h1>Evidencias</h1>

        <p>
          En esta sección se encuentran las evidencias y trabajos
          desarrollados durante el curso.
        </p>
      </section>

      <section class="evidencias-grid">

        <div class="evidencia-card">
          <span class="card-number">01</span>

          <h2>SQL</h2>

          <p>
            Consultas y ejercicios desarrollados utilizando SQL.
          </p>

          <span class="status">Próximamente</span>
        </div>

        <div class="evidencia-card">
          <span class="card-number">02</span>

          <h2>PL/SQL Scripts</h2>

          <p>
            Scripts y ejercicios desarrollados utilizando PL/SQL.
          </p>

          <span class="status">Próximamente</span>
        </div>

        <div class="evidencia-card">
          <span class="card-number">03</span>

          <h2>NoSQL</h2>

          <p>
            Evidencias relacionadas con bases de datos NoSQL.
          </p>

          <span class="status">Próximamente</span>
        </div>

        <div class="evidencia-card">
          <span class="card-number">04</span>

          <h2>Proyecto</h2>

          <p>
            Evidencias y avances del proyecto desarrollado durante el curso.
          </p>

          <span class="status">Próximamente</span>
        </div>

      </section>

    </main>

    <Footer />
  </body>
</html>

<style>
  .evidencias-page {
    max-width: 1100px;
    margin: 5rem auto;
    padding: 0 1.5rem;
  }

  .evidencias-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .section-label {
    display: block;
    margin-bottom: 0.75rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--accent);
  }

  .evidencias-header h1 {
    margin: 0 0 1rem;
    font-size: 3rem;
  }

  .evidencias-header p {
    max-width: 650px;
    margin: 0 auto;
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  .evidencias-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .evidencia-card {
    padding: 2rem;
    border: 1px solid var(--color-border);
    border-radius: 18px;
    background: var(--color-background);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease;
  }

  .evidencia-card:hover {
    transform: translateY(-5px);
    border-color: var(--accent);
  }

  .card-number {
    display: block;
    margin-bottom: 1rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.1em;
  }

  .evidencia-card h2 {
    margin-bottom: 0.75rem;
  }

  .evidencia-card p {
    margin-bottom: 1.5rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .status {
    display: inline-block;
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-size: 0.75rem;
    color: var(--color-text-secondary);
  }

  @media (max-width: 768px) {
    .evidencias-page {
      margin: 3rem auto;
    }

    .evidencias-header h1 {
      font-size: 2.3rem;
    }

    .evidencias-grid {
      grid-template-columns: 1fr;
    }
  }
</style>