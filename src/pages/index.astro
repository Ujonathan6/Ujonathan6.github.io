---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/sections/Footer.astro';
import Header from '../components/sections/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import HeroSection from '../components/sections/HeroSection.astro';
import SkillsSection from '../components/sections/SkillsSection.astro';
import { skills } from '../data/skills';
import WorkExperience from '../components/sections/WorkExperience.astro';
import { work } from '../data/work';
import Studies from '../components/sections/Studies.astro';
import { studies } from '../data/studies';
import Carousel from '../components/ui/carousel/Carousel.astro';
import { logos } from '../data/logos';
import ArrowSeparator from '../components/ui/separator/ArrowSeparator.astro'
import GlowLineSeparator from '../components/ui/separator/GlowLineSeparator.astro'

// Logos
import astroLogo from '../assets/logos/Astro-logo.svg';
import googleAdsLogo from '../assets/logos/GoogleAds-logo.svg';
import posthogLogo from '../assets/logos/posthog-logo.svg';
import notionLogo from '../assets/logos/Notion-logo.svg';
import figmaLogo from '../assets/logos/Figma-logo.svg';

// Avatar
import avatar from '../assets/images/sample-avatar.jpg';


// skills are imported from src/data/skills
---

<!doctype html>
<html lang="es" data-theme="dark" class="dark">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />

    <!-- JSON-LD: Organization -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: 'Site Author',
        url: new URL('/', Astro.site).toString(),
        logo: new URL('/favicon.svg', Astro.site).toString(),
        sameAs: [
          'https://x.com',
          'https://www.linkedin.com/in/guilherme-hubie/',
        ],
      })}
    />
  </head>

  <body>
    <Header />

    <main>

      <!-- Hero -->
      <HeroSection
        title="Your Headline Goes Here!"
        subtitle="I build softwares that brings you loyal subscribers."
        showCTA
        primaryCTA={{ text: 'View Projects', href: '/portfolio' }}
        secondaryCTA={{ text: 'Read Blog', href: '/blog' }}
      />

      <!-- Presentación -->
      <section id="presentacion" class="presentation-section">
        <div class="presentation-header">
          <span class="section-label">SOBRE MÍ</span>
          <h2>Presentación</h2>
          <p>
            Conoce un poco más sobre mí, mi perfil y el trabajo que he
            desarrollado durante mi formación.
          </p>
        </div>

        <div class="presentation-content">

          <!-- Foto / Avatar -->
          <div class="avatar-container">
            <img
              src={avatar.src}
              alt="Foto de presentación"
              class="avatar"
            />
          </div>

          <!-- Video -->
          <div class="video-container">
            <iframe
              src="https://www.youtube.com/embed/VtbmEBHDD5k"
              title="Video de presentación"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>

        </div>
      </section>

      <!-- Skills y demás contenido -->
      <section class="py-6">
        <ArrowSeparator />

        <SkillsSection
          title="Skills & Tools"
          skills={skills}
        />

        <ArrowSeparator />

        <WorkExperience
          title="Work Experience"
          items={work}
        />

        <ArrowSeparator />

        <Studies
          title="Studies"
          items={studies}
        />

        <GlowLineSeparator />
      </section>

    </main>

    <Footer />
  </body>
</html>

<style>
  /* =========================
     PRESENTACIÓN
     ========================= */

  .presentation-section {
    max-width: 1100px;
    margin: 5rem auto;
    padding: 0 1.5rem;
  }

  .presentation-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .section-label {
    display: block;
    margin-bottom: 0.75rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--accent);
  }

  .presentation-header h2 {
    margin: 0 0 1rem;
    font-size: 2.5rem;
  }

  .presentation-header p {
    max-width: 650px;
    margin: 0 auto;
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  .presentation-content {
    display: grid;
    grid-template-columns: 220px 1fr;
    align-items: center;
    gap: 3rem;
  }

  /* =========================
     AVATAR
     ========================= */

  .avatar-container {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .avatar {
    width: 200px;
    height: 200px;
    object-fit: cover;
    border-radius: 50%;
    border: 3px solid var(--accent);
    box-shadow: 0 0 30px rgba(255, 255, 255, 0.08);
  }

  /* =========================
     VIDEO
     ========================= */

  .video-container {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 16px;
    background: #000;
    box-shadow: 0 10px 35px rgba(0, 0, 0, 0.25);
  }

  .video-container iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  /* =========================
     RESPONSIVE
     ========================= */

  @media (max-width: 768px) {
    .presentation-section {
      margin: 3rem auto;
    }

    .presentation-header h2 {
      font-size: 2rem;
    }

    .presentation-content {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .avatar {
      width: 160px;
      height: 160px;
    }
  }
</style>